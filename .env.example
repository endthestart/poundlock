# Release bundles replace this with the verified image digest.
POUNDLOCK_IMAGE=
POUNDLOCK_LISTEN_ADDRESS=127.0.0.1
# Keep these defaults for image-owned named volumes. Custom existing volumes
# must be writable by the configured supervisor UID/GID.
POUNDLOCK_UID=10001
POUNDLOCK_GID=10001
# Add POUNDLOCK_DOCKER_GID using the Linux host socket group; see README.md.
POUNDLOCK_RUNNER_CAPACITY=1
POUNDLOCK_PORT=7331
POUNDLOCK_EXTERNAL_TIMEOUT_SECONDS=600
POUNDLOCK_JOB_INFERENCE_TIMEOUT_SECONDS=1200
# Unfinished jobs one application token may hold.
POUNDLOCK_MAX_ACTIVE_JOBS_PER_TOKEN=10
# Requests served at once, streams included; over it the controller answers 503.
POUNDLOCK_MAX_REQUESTS_IN_FLIGHT=512
POUNDLOCK_JOB_WALL_SECONDS=3600
# Supervisor /work tmpfs only. Job workspace volumes stay 2 GiB.
POUNDLOCK_WORK_SIZE=2g
POUNDLOCK_LOG=poundlock=info
# Permit explicit per-job outbound access: public addresses on ports 80 and 443
# through the supervisor's proxy, never the local network.
POUNDLOCK_ALLOW_JOB_NETWORK=false
# Models > Discover can compare routes with OpenRouter's public catalog, a request
# from the controller to openrouter.ai. on-request: only when an operator clicks
# Look up; always: on every Discover load; never: not at all.
POUNDLOCK_OPENROUTER_CATALOG=on-request
# Run job containers under gVisor once runsc is installed on this Docker host.
# POUNDLOCK_WORKER_RUNTIME=runsc
