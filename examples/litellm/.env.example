# Use reviewed immutable image references. Do not use a floating tag in a release deployment.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm@sha256:REPLACE_ME
POSTGRES_IMAGE=postgres@sha256:REPLACE_ME

# The master key must start with sk-. Generate independent random values.
LITELLM_MASTER_KEY=sk-REPLACE_ME
LITELLM_SALT_KEY=REPLACE_ME
# Use a long URL-safe value because this password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_VALUE

# Keep the default local during evaluation. Use a private interface or reverse
# proxy only when the Poundlock controller must connect from another host.
LITELLM_LISTEN_ADDRESS=127.0.0.1
LITELLM_PORT=4000
