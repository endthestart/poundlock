# Rust / Cargo build output
/target/
**/*.rs.bk

# Native debug and build leftovers (never commit these)
debug/
build/

# Local secrets and runtime state
.env
.env.*
!.env.example
/data/
*.sqlite3
# The node's default --config and --credential-file paths
/node-credential.json
/node.toml

# Local reference checkouts
/source/

# IDE, OS and agent tools
.DS_Store
.idea/
.vscode/
.claude/
*.swp
*~

# Python tooling if present on a mixed workstation
.venv/
__pycache__/
*.py[cod]

# Generated release artifacts
/dist/
/node-artifacts/*
!/node-artifacts/.gitkeep
