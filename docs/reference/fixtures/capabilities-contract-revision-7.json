{
  "schema_version": 1,
  "api_major": 1,
  "contract_revision": 7,
  "product_version": "0.4.4",
  "features": [
    "access_preflight",
    "availability_reasons",
    "caller_permissions",
    "capability_evidence",
    "capacity_queue",
    "data_destination",
    "durable_jobs",
    "external_invoke_permission",
    "frontier_budget",
    "job_budget",
    "managed_application_identities",
    "model_status",
    "permission_labels",
    "reasoning_levels",
    "route_catalog",
    "routing_revision",
    "usage_summary",
    "verifier_toolchain"
  ],
  "token_permissions": [
    {
      "code": "models:read",
      "label": "List available models"
    },
    {
      "code": "inference:invoke",
      "label": "Send inference requests"
    },
    {
      "code": "inference:priority",
      "label": "Go ahead of other work when a model is busy"
    },
    {
      "code": "external:invoke",
      "label": "Send prompts and files to external services"
    },
    {
      "code": "jobs:read",
      "label": "Read its own jobs and results"
    },
    {
      "code": "jobs:submit",
      "label": "Submit jobs with supplied files"
    },
    {
      "code": "jobs:cancel",
      "label": "Cancel its own jobs"
    }
  ],
  "verifier": {
    "python": "3.14",
    "uv": "0.12.24",
    "writable_exec_paths": [
      "/tmp",
      "/work",
      "/home/worker"
    ]
  }
